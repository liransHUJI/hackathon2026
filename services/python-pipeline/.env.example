# Required for semantic generation and LLM judge features.
ANTHROPIC_API_KEY=

# Current demo/analyzer code can use Gemini when configured.
GEMINI_API_KEY=

# Scraper backend. Use "basic" locally; use "brightdata" only with a budgeted key.
SCRAPER_BACKEND=basic
BRIGHTDATA_API_KEY=
BRIGHTDATA_BUDGET_USD=75.0

# Optional AI-detection providers. Missing providers are excluded from the ensemble.
GPTZERO_API_KEY=
SAPLING_API_KEY=

# Optional ingestion sources.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=
RSS_FEEDS=

# Pipeline tuning defaults.
PERMUTATION_COUNT=100
MAX_SCRAPE_RESULTS=200
SIMILARITY_THRESHOLD=0.45
TOP_CANDIDATES=10
SCRAPER_CONCURRENCY=10
AI_DETECTION_THRESHOLD=0.65
