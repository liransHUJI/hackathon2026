# ══════════════════════════════════════════════════════════════════════════════
#  Provenance Pipeline — Environment Variables
#  Copy this file to .env and fill in your values.
#  .env is gitignored and must never be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────
# Gemini — powers the SemanticAgent (free tier available at aistudio.google.com)
GEMINI_API_KEY=

# Anthropic — optional; used by the LLM-Judge AI-detector later
# ANTHROPIC_API_KEY=sk-ant-...

# ── Scraper backend ───────────────────────────────────────────────────────────
# "basic"      → DuckDuckGo + httpx (default, free, no extra credentials)
# "brightdata" → Bright Data SERP + Web Unlocker (hackathon day only)
SCRAPER_BACKEND=basic

# Bright Data — only needed when SCRAPER_BACKEND=brightdata
# BRIGHTDATA_API_KEY=...
# BRIGHTDATA_BUDGET_USD=75.0    # Hard spend cap — never bypass this

# ── AI Detection APIs (optional) ──────────────────────────────────────────────
# The pipeline degrades gracefully if these are absent:
# missing keys → those methods are skipped; ensemble is renormalised.
# GPTZERO_API_KEY=...
# SAPLING_API_KEY=...

# ── Telegram ingestion (optional) ─────────────────────────────────────────────
# Obtain credentials from https://my.telegram.org
# TELEGRAM_API_ID=...
# TELEGRAM_API_HASH=...
# TELEGRAM_CHANNELS=channel_handle_1,channel_handle_2

# ── RSS ingestion (optional) ──────────────────────────────────────────────────
# Comma-separated list of feed URLs
# RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml

# ── LLM tuning ────────────────────────────────────────────────────────────────
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.9
# LLM_REQUESTS_PER_MINUTE=50
# LLM_TOKENS_PER_MINUTE=60000

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# PERMUTATION_COUNT=100
# MAX_SCRAPE_RESULTS=200
# SIMILARITY_THRESHOLD=0.45
# TOP_CANDIDATES=10
# SCRAPER_CONCURRENCY=10
# DOMAIN_RATE_LIMIT_RPS=2.0
# AI_DETECTION_THRESHOLD=0.65
# EMBEDDING_MODEL=all-MiniLM-L6-v2
