HTTP_ADDR=:8080
DATABASE_URL=postgres://provenance:provenance@localhost:5432/provenance?sslmode=disable
NATS_URL=nats://localhost:4222

# LLM provider. Missing credentials reduce explanation quality; data is never fabricated.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_TOKENS_PER_MINUTE=60000

# Source providers.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_X_DATASET_ID=
BRIGHTDATA_SEARCH_DATASET_ID=
BRIGHTDATA_BUDGET_USD=75
BRIGHTDATA_X_REQUESTS_PER_MINUTE=30
BRIGHTDATA_WEB_REQUESTS_PER_MINUTE=30
BASIC_WEB_DOMAIN_RPS=2

# Narrative Integrity Engine defaults.
RETENTION_DAYS=7
DEFAULT_TOP_NARRATIVES=20
INTERACTIONS_PER_NARRATIVE=2000
CRAWL_INTERVAL_SECONDS=900
